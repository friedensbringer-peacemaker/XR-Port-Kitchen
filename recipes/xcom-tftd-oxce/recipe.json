  "port": {
    "repo": "https://github.com/friedensbringer-peacemaker/xr.openxcom",
    "branch": "xr-quest",
    "local_path": "<XR-Ordner>/XR-OpenXcom/fanport/OpenXcom-Android"
  },
  "build": {
    "repo": "https://github.com/friedensbringer-peacemaker/xr.openxcom",
    "branch": "xr-quest",
    "submodules": true,
    "steps": [
      "./gradlew assembleDebug"
    ],
    "apk": "app/build/outputs/apk/debug/*.apk",
    "note": "Aus einem frischen Klon auf einem anderen Rechner noch nicht getestet.",
    "note_en": "Not yet tested from a fresh clone on another computer."
  },
  "ratings": {
    "portability": 4,
    "xr_potential": 5,
    "base_maturity": 5,
    "note": "Fertiger Android-Port der aktiven OXCE-Engine; OpenXR kam als eigener Renderer dazu. Geoscape als Globus und die Kampfkarte als Tisch – eines der stärksten XR-Potenziale im Katalog."
  },
  "effort": {
    "with_apk": "15–30 min",
    "from_source": "1–2 h plus ~12 min erster Build",
    "with_apk_en": "15–30 min"
  },
  "ingredients": {
    "original_assets": {
      "hint": "TFTD-Ordner deiner GOG-/Steam-Installation (mit innoextract entpackt) – dort liegen GEODATA, GEOGRAPH, MAPS, SOUND usw.",
      "required": [
        "ANIMS",
        "FLOP_INT",
        "GEODATA",
        "GEOGRAPH",
        "MAPS",
        "ROUTES",
        "SOUND",
        "TERRAIN",
        "UFOGRAPH",
        "UNITS",
        "GEODATA/PALETTES.DAT"
      ],
      "device_path": "/sdcard/openxcom/TFTD (braucht die Berechtigung „Alle Dateien“; Log und Einstellungen in /sdcard/openxcom/)",
      "transfer": "kitchen push xcom-tftd-oxce <TFTD-Ordner>; danach Berechtigung „Alle Dateien“ erteilen",
      "hint_en": "TFTD folder of your GOG/Steam installation (unpacked with innoextract) – contains GEODATA, GEOGRAPH, MAPS, SOUND etc."
    },
    "push": {
      "source": "dir",
      "target": "/sdcard/openxcom/TFTD",
      "include": [
        "ANIMS",
        "FLOP_INT",
        "GEODATA",
        "GEOGRAPH",
        "MAPS",
        "ROUTES",
        "SOUND",
        "TERRAIN",
        "UFOGRAPH",
        "UNITS"
      ],
      "verify": [
        "GEODATA/PALETTES.DAT",
        "SOUND/GM.CAT"
      ],
      "note": "Danach die Berechtigung erteilen: beim ersten Start „Zugriff auf alle Dateien“ erlauben oder adb shell appops set --uid xr.openxcom MANAGE_EXTERNAL_STORAGE allow",
      "note_en": "Then grant the permission: allow “access to all files” on first start, or run adb shell appops set --uid xr.openxcom MANAGE_EXTERNAL_STORAGE allow"
    },
    "modules": [
      "quest-tools",
      "openxr-videodriver-pattern",
      "vr-menu-pflicht"
    ]
  },
  "tools": [
    {
      "id": "adb"
    },
    {
      "id": "innoextract"
    },
    {
      "id": "git",
      "only_for": "build"
    },
    {
      "id": "jdk",
      "version": "17",
      "only_for": "build"
    },
    {
      "id": "android-platform",
      "version": "35",
      "only_for": "build"
    },
    {
      "id": "android-ndk",
      "version": "30.0",
      "only_for": "build"
    },
    {
      "id": "cmake",
      "only_for": "build"
    }
  ],
