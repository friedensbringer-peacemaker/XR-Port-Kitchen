{
  "id": "dotnet",
  "name": ".NET SDK",
  "purpose": "Engines in C# (z. B. OpenRA) bauen",
  "url": "https://dotnet.microsoft.com",
  "license": "MIT",
  "min_version": "8.0",
  "check": {
    "windows": { "kind": "exe", "candidates": ["dotnet"], "args": "--version", "version_regex": "^([0-9]+\\.[0-9]+\\.[0-9]+)" },
    "macos":   { "kind": "exe", "candidates": ["dotnet", "/usr/local/share/dotnet/dotnet"], "args": "--version", "version_regex": "^([0-9]+\\.[0-9]+\\.[0-9]+)" }
  },
  "install": {
    "windows": "winget install Microsoft.DotNet.SDK.8",
    "macos": "brew install --cask dotnet-sdk"
  }
}
