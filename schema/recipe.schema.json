{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xr-port-kitchen/recipe.schema.json",
  "title": "XR-Port-Kitchen Rezept",
  "type": "object",
  "required": ["id", "title", "status", "game", "base", "ratings", "effort", "ingredients", "tools", "stages", "xr_modes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "description": "Anzeigename, z. B. 'Die Siedler II via Return to the Roots'" },
    "status": { "enum": ["draft", "in-progress", "playable", "verified"], "description": "draft = Analyse; in-progress = Stufen laufen; playable = im Headset spielbar; verified = Abnahme bestanden" },
    "last_verified": { "type": "string", "description": "Datum + Art der letzten Prüfung, z. B. '2026-09-27 headset'" },
    "app": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^xr\\.[a-z0-9.]+$" },
        "label": { "type": "string", "pattern": "^xr\\.[a-z0-9.]+$" },
        "version": { "type": "string" }
      }
    },
    "game": {
      "type": "object",
      "required": ["name", "rights_holder", "buy"],
      "properties": {
        "name": { "type": "string" },
        "platform": { "type": "string", "description": "z. B. PC/DOS, PC/Windows, Konsole" },
        "year": { "type": "integer" },
        "rights_holder": { "type": "string" },
        "buy": { "type": "array", "items": { "type": "string" }, "description": "Legale Bezugsquellen ohne Shop-Links, z. B. 'GOG', 'Steam', 'Original-CD'" }
      }
    },
    "base": {
      "type": "array",
      "minItems": 1,
      "description": "Upstream-Projekte, auf denen das Rezept aufbaut (Credits!)",
      "items": {
        "type": "object",
        "required": ["name", "url", "license"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "license": { "type": "string" },
          "role": { "type": "string" },
          "ref": { "type": "string", "description": "Branch, Tag oder Commit, mit dem das Rezept geprüft ist" }
        }
      }
    },
    "port": {
      "type": "object",
      "description": "Eigener Port-Code (Repo, Branch, lokaler Pfad)",
      "properties": {
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "local_path": { "type": "string" }
      }
    },
    "build": {
      "type": "object",
      "description": "Selbst bauen mit 'kitchen build': öffentlicher Port-Code, Bauschritte (Shell; unter Windows Git Bash), Fundort der APK",
      "required": ["repo", "steps", "apk"],
      "properties": {
        "repo": { "type": "string", "pattern": "^https://" },
        "branch": { "type": "string" },
        "submodules": { "type": "boolean" },
        "steps": { "type": "array", "items": { "type": "string" }, "description": "werden mit && verkettet und im Repo-Ordner ausgeführt" },
        "apk": { "type": "string", "description": "Pfad oder Muster relativ zum Repo, z. B. android/build/outputs/apk/debug/*.apk" },
        "note": { "type": "string" },
        "note_en": { "type": "string" }
      }
    },
    "ratings": {
      "type": "object",
      "required": ["portability", "xr_potential", "base_maturity"],
      "properties": {
        "portability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "xr_potential": { "type": "integer", "minimum": 1, "maximum": 5 },
        "base_maturity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "note": { "type": "string" }
      }
    },
    "effort": {
      "type": "object",
      "properties": {
        "with_apk": { "type": "string", "description": "Einsteiger mit fertiger APK, z. B. '20–40 min'" },
        "from_source": { "type": "string", "description": "Profis, kompletter Build, z. B. '1–2 Tage'" }
      }
    },
    "ingredients": {
      "type": "object",
      "properties": {
        "original_assets": {
          "type": "object",
          "description": "Was der Spieler aus der eigenen Kopie mitbringt. Nur Pfade, nie Inhalte.",
          "properties": {
            "hint": { "type": "string", "description": "Wo man den Ordner typischerweise findet" },
            "required": { "type": "array", "items": { "type": "string" }, "description": "Relative Pfade, die alle vorhanden sein müssen" },
            "any_of": { "type": "array", "items": { "type": "array", "items": { "type": "string" } }, "description": "Gruppen, von denen je mindestens ein Pfad vorhanden sein muss" },
            "device_path": { "type": "string", "description": "Zielordner auf der Quest" },
            "transfer": { "type": "string", "description": "Wie die Daten auf die Quest kommen (Skript/Weg)" }
          }
        },
        "push": {
          "type": "object",
          "description": "Wie 'kitchen push' die Spieldaten des Spielers auf die Quest bringt",
          "required": ["target"],
          "properties": {
            "source": { "enum": ["dir", "archive", "file"], "description": "dir = Ordner (wird als tar übertragen), archive = .zip/.tar (auf dem Gerät entpackt), file = einzelne Datei" },
            "target": { "type": "string", "description": "Zielordner; Platzhalter {app} (App-ID) und {name} (Name, Standard: Ordnername der Quelle); bei run_as relativ zum App-Datenordner" },
            "run_as": { "type": "boolean", "description": "In den privaten Speicher der App schreiben (run-as, nur Debug-Builds)" },
            "include": { "type": "array", "items": { "type": "string" }, "description": "dir: nur diese Einträge übertragen" },
            "exclude": { "type": "array", "items": { "type": "string" }, "description": "dir: tar-Ausschlussmuster" },
            "verify": { "type": "array", "items": { "type": "string" }, "description": "Pfade relativ zum Ziel, die danach existieren müssen" },
            "source_sha1": { "type": "string", "description": "archive/file: erwartete SHA-1 der Quelle" },
            "note": { "type": "string", "description": "Hinweis nach erfolgreicher Übertragung" }
          }
        },
        "modules": { "type": "array", "items": { "type": "string" }, "description": "IDs aus ingredients/*.json" }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "min_version": { "type": "string" },
              "version": { "type": "string", "description": "Präfix-Bindung, z. B. '27' = jede 27.x" },
              "only_for": { "enum": ["build", "play"] }
            }
          }
        ]
      },
      "description": "IDs aus tools/*.json. only_for=build: nur für den Bau aus dem Quellcode nötig"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "done_when", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "actions": { "type": "array", "items": { "type": "string" } },
          "done_when": { "type": "string", "description": "Prüfbares Erfolgskriterium" },
          "automatable": { "enum": ["full", "partial", "manual"] },
          "status": { "enum": ["done", "open", "blocked", "n/a"] },
          "evidence": { "type": "string", "description": "Beleg: Datum, Version, Datei" }
        }
      }
    },
    "xr_modes": {
      "type": "object",
      "propertyNames": { "enum": ["screen", "passthrough", "tabletop", "diorama", "full-vr"] },
      "additionalProperties": { "enum": ["done", "partial", "planned", "unsuitable"] }
    },
    "known_issues": { "type": "array", "items": { "type": "string" } },
    "legal": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
